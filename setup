#!/bin/bash

# Color codes
cblue='\033[0;34m'
cpink='\033[1;35m'
cyellow='\033[0;33m'
cgreen='\033[0;32m'
ccyan='\033[0;36m'
cpurple='\033[0;35m'
cwhite='\033[1;37m'
creset='\033[0m'

# BADMUSIC ASCII Art Header (Blue + Pink)
echo -e "${cblue}  ____          _____  __  __ _    _  _____ _____ _____ "
echo -e " |  _ \   /\   |  __ \|  \/  | |  | |/ ____|_   _/ ____|"
echo -e " | |_) | /  \  | |  | | \  / | |  | | (___   | || |     "
echo -e " |  _ < / /\ \ | |  | | |\/| | |  | |\___ \  | || |     "
echo -e " | |_) / ____ \| |__| | |  | | |__| |____) |_| || |____ "
echo -e " |____/_/    \_\_____/|_|  |_|\____/|_____/|_____\_____|${cpink}"
echo -e "                                                        ${creset}"

pprint (){
    color=$1
    shift
    printf "${color}%b${creset}" "$*"
}

color_reset(){ printf "${creset}"; }

yesnoprompt(){
    old_stty_cfg=$(stty -g)
    stty raw -echo ; answer=$(head -c 1)
    stty $old_stty_cfg
    echo "$answer" | grep -iq "^y"
}

update() {
    pprint "${cpurple}" "\n\nUpdating package list.. "
    sudo apt update 2>&1 | grep "can be upgraded" &>/dev/null
    if [ $? -eq 0 ]; then
        pprint "${cgreen}" "UPDATE AVAILABLE"
        pprint "${cpurple}" "\n\nDo you want to automatically upgrade (y/n)?"
        if yesnoprompt; then
            pprint "${cpurple}" "\n\nUpgrading packages.. "
            sudo apt upgrade -y &>/dev/null &&
            pprint "${cgreen}" "DONE!\n\n" || (pprint "${cblue}" "FAIL.\n\n"; exit 1)
        else
            echo
        fi
    else
        pprint "${cgreen}" "ALREADY UP TO DATE\n\n"
    fi
}

packages(){
    if ! command -v pip &>/dev/null; then
        pprint "${cyellow}" "Couldn't found pip, installing now..."
        sudo apt install python3-pip -y 2>pypilog.txt 1>/dev/null &&
        pprint "${cgreen}" "SUCCESS.\n\n" || (pprint "${cpink}" "FAIL.\n\n"; exit 1)
    fi

    if ! command -v ffmpeg &>/dev/null; then
        pprint "${cyellow}" "Couldn't found ffmpeg, installing now..."
        if sudo apt install ffmpeg -y &>/dev/null;then
            pprint "${cgreen}" "SUCCESS.\n\n"
        else
            pprint "${cpink}" "FAIL.\n\n"
            pprint "${cblue}" "You need to install ffmpeg manually in order to deploy BADMUSIC, exiting...\n"
            exit 1
        fi
    fi

    # Check ffmpeg version and warn user if necessary.
    fv=$(grep -Po 'version (3.*?) ' <<< $(ffmpeg -version)) &&
    pprint "${cpurple}" "Playing live streams not going to work since you have ffmpeg $fv, live streams are supported by version 4+.\n"
}

node(){
    command -v npm &>/dev/null && return
    pprint "${cpurple}" "Installing Nodejs and Npm..  "
    curl -fssL https://deb.nodesource.com/setup_19.x | sudo -E bash - &>nodelog.txt &&
    sudo apt install -y nodejs &>>nodelog.txt &&
    sudo npm i -g npm &>>nodelog.txt &&
    pprint "${cgreen}" "SUCCESS!\n" || (pprint "${cpink}" "FAIL.\n"; exit 1)
}

installation(){
    pprint "${cyellow}" "\n\nUpgrading pip and installing dependency packages..."
    pip3 install -U pip &>>pypilog.txt &&
    pip3 install -U -r requirements.txt &>>pypilog.txt &&
    pprint "${cgreen}" "DONE.\n" && return
    pprint "${cpink}" "FAIL.\n"
    exit 1
}

clear
pprint "${cyellow}" "If you see any error during Installation Process, Please refer to these files for logs:\n"
pprint "${cpurple}" "\nFor node js errors , Checkout nodelog.txt\n"
pprint "${cblue}" "For pypi packages errors , Checkout pypilog.txt\n"
sleep 1
pprint "${cgreen}" "\n\nScript needs sudo privileges in order to update & install packages.\n"
sudo test

update
packages
node
installation
pprint "${cgreen}" "\n\n\n\n\nBADMUSIC Installation Completed !"
sleep 1
clear

# Multi-color input prompts
pprint "${cblue}" "\nAPI ID: "; color_reset; read api_id
pprint "${cwhite}" "\nAPI HASH: "; color_reset; read api_hash
pprint "${cpink}" "\nBOT TOKEN: "; color_reset; read bot_token
pprint "${cyellow}" "\nOWNER ID:"; color_reset; read ownid
pprint "${cgreen}" "\nMONGO DB URI: "; color_reset; read mongo_db
pprint "${ccyan}" "\nLOG GROUP ID: "; color_reset; read logger
pprint "${cpurple}" "\nSTRING SESSION: "; color_reset; read string_session

pprint "${cgreen}" "\n\nProcessing your vars, wait a while !"

if [ -f .env ]; then
    rm .env
fi

echo """API_ID = $api_id
API_HASH = $api_hash
BOT_TOKEN = $bot_token
MONGO_DB_URI = $mongo_db
LOG_GROUP_ID = $logger
STRING_SESSION = $string_session
OWNER_ID = $ownid""" > .env
clear

pprint "${cpink}" "\n\n\nThanks for using BADMUSIC installer, your vars have been saved successfully ! \nIf you wanna add more variables add them in your env by : vi .env"
pprint "${cyellow}" "\n\nNow you can start the bot by : bash start\n\n"
